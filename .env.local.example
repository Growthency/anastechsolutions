# ---- Session signing secret ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---- Admin credentials (optional overrides) ----
# If not set, the app uses the baked-in defaults defined in src/lib/auth/credentials.ts.
# ADMIN_EMAIL=infoabubakar786@gmail.com
# ADMIN_PASSWORD_HASH=<salt>:<scrypt_hex>
#   Generate with:
#   node -e "const c=require('crypto'); const s=c.randomBytes(16).toString('hex'); const h=c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'); console.log(s+':'+h)"

# ---- Supabase (required for creating posts) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Analytics 4 + Search Console (admin analytics dashboard) ----
# 1. Create a service account in Google Cloud (enable "Google Analytics Data API"
#    and "Google Search Console API").
# 2. Download the JSON key. Paste the WHOLE file as a single line into
#    GOOGLE_SERVICE_ACCOUNT_JSON (or split into the two vars below).
# 3. In GA4 Admin -> Property Access, add the service account email as Viewer.
# 4. In Search Console, add the service account email as a User on the property.
#
# GA4_PROPERTY_ID: numeric GA4 property id (e.g. 123456789), found in GA4 Admin -> Property Details.
# SEARCH_CONSOLE_SITE_URL: exactly as shown in Search Console.
#   - Domain property:  "sc-domain:anastechsolutions.com"
#   - URL prefix:       "https://anastechsolutions.com/"
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=

# ---- Secure Vault (optional) ----
# AES-256-GCM encryption key for /admin/vault credential storage.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, falls back to SESSION_SECRET. Rotating this invalidates all stored passwords.
VAULT_SECRET=
